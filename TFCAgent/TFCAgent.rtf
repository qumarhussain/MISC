\f1\b\fs36 \cf0 \strokec3 \uc0\u55357 \u56550  Terraform Code: Provision EC2 + Install Docker + Run Agent\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 hcl\
\pard\pardeftab720\partightenfactor0

\f3\fs22 \cf4 \cb5 \strokec4 CopyEdit
\f2\fs26 \cf0 \cb1 \strokec3 \
provider "aws" \{\
  region = "us-east-1"\
\}\
\
variable "vpc_id" \{\
  default = "vpc-xxxxxxxx" # Replace with your actual VPC ID\
\}\
\
variable "subnet_id" \{\
  default = "subnet-xxxxxxxx" # Replace with a public or NAT-enabled subnet\
\}\
\
resource "aws_security_group" "tfc_agent_sg" \{\
  name        = "tfc-agent-sg"\
  description = "Security group for Terraform Cloud Agent"\
  vpc_id      = var.vpc_id\
\
  egress \{\
    from_port   = 443\
    to_port     = 443\
    protocol    = "tcp"\
    cidr_blocks = ["0.0.0.0/0"]\
  \}\
\
  ingress \{\
    from_port   = 22\
    to_port     = 22\
    protocol    = "tcp"\
    cidr_blocks = ["YOUR_PUBLIC_IP/32"] # Restrict to your IP for SSH\
  \}\
\}\
\
resource "aws_instance" "tfc_agent" \{\
  ami                    = "ami-0c02fb55956c7d316" # Amazon Linux 2 (update as needed)\
  instance_type          = "t3.micro"              # Use larger for heavier workloads\
  subnet_id              = var.subnet_id\
  key_name               = "your-key-name"         # Optional\
  vpc_security_group_ids = [aws_security_group.tfc_agent_sg.id]\
\
  user_data = <<-EOF\
              #!/bin/bash\
              yum update -y\
              amazon-linux-extras install docker -y\
              systemctl enable docker\
              systemctl start docker\
              usermod -aG docker ec2-user\
\
              # Pull and run the TFC Agent\
              docker pull hashicorp/tfc-agent:latest\
\
              docker run -d \\\\\
                --name=tf-agent \\\\\
                --restart unless-stopped \\\\\
                -e TFC_AGENT_TOKEN=<your-agent-token> \\\\\
                -e TFC_AGENT_NAME="ec2-agent" \\\\\
                hashicorp/tfc-agent:latest\
              EOF\
\
  tags = \{\
    Name = "Terraform Cloud Agent"\
  \}\
\}\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 \uc0\u55357 \u56592  Security Tip:\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b0\fs24 \cf0 Instead of embedding your token in 
\f2\fs26 user_data
\f0\fs24 , fetch it dynamically:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 bash\
